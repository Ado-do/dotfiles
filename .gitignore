# Machine-local files: secrets, identity, personal paths (never commit)
/.config/waybar/lastfm.json
/.config/git/config.local
/.bashrc.d/local.sh
/.config/sway/config.d/61-bindings-local.conf

# Backups, caches and logs
*.bak
*.bak-*
__pycache__/
*.pyc
*.log

# tmux plugins: reinstalled by TPM (prefix + I)
/.config/tmux/plugins/

# Active waybar theme, written by scripts/theme.sh
/.config/waybar/style.css

# Compiled nvim spell files: regenerated by nvim
/.config/lazyvim/spell/*.spl
/.config/lazyvim/spell/*.sug
