# Identity lives in config.local (untracked): a [user] block with name and email
[include]
	path = config.local
[alias]
    # Opens the remote 'origin' URL in your default browser
    browse = !sh -c 'git remote get-url ${1:-origin} | xargs xdg-open' -
	dft = -c diff.external=difft diff
	dlog = -c diff.external=difft log -p --ext-diff
	dshow = -c diff.external=difft show --ext-diff
[init]
	defaultBranch = main
[credential]
	helper = cache
[core]
	excludesfile = /home/aibe/.config/git/gitignore
	quotepath = false
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
