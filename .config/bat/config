# Bat Configuration File
# Documentation: https://github.com/sharkdp/bat

# Color theme
--theme="tokyonight_night"

# Visual style components (numbers, git changes, file header, and grid border)
--style="auto"

# Enable italic text rendering
--italic-text=always

# Automatic paging (pages only when content overflows terminal height)
--paging=auto

# Tab width
--tabs=4
